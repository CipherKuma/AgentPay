# ===========================================
# AgentPay Environment Configuration
# ===========================================

# Server Configuration
PORT=4402
NODE_ENV=development

# ===========================================
# Movement Network Configuration
# ===========================================

# Wallet address to receive payments (REQUIRED)
MOVEMENT_PAY_TO=0x...your_wallet_address

# x402 Facilitator URL (default: x402.org)
MOVEMENT_FACILITATOR_URL=https://facilitator.x402.org

# Movement RPC URL (for contract interactions)
MOVEMENT_RPC_URL=https://mainnet.movementnetwork.xyz/v1

# Treasury contract address (optional, for on-chain tracking)
TREASURY_ADDRESS=0x...

# ===========================================
# Provider API Keys
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Together AI (optional)
TOGETHER_API_KEY=...

# Replicate (optional)
REPLICATE_API_TOKEN=...

# Anthropic (optional)
ANTHROPIC_API_KEY=...

# ===========================================
# Dashboard Configuration
# ===========================================

# Dashboard API URL
NEXT_PUBLIC_API_URL=http://localhost:4402

# ===========================================
# Optional: Database (for persistent storage)
# ===========================================

# DATABASE_URL=postgresql://user:password@localhost:5432/agentpay
# REDIS_URL=redis://localhost:6379
